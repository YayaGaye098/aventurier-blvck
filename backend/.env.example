# Copiez ce fichier en .env et adaptez les valeurs.

# "production" sur le serveur en ligne : refuse la clé par défaut et masque /docs.
ENVIRONMENT=development

# Clé secrète (64 caractères) : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=remplacez-par-une-longue-chaine-aleatoire

# DATABASE_URL=mysql+pymysql://user:motdepasse@localhost/aventurier_blvck

# Adresse(s) du site, séparées par des virgules
CORS_ORIGINS=http://localhost:4200

MAX_VIDEO_MB=60

# Adresse publique du site (aperçus des liens partagés). Vide = déduite automatiquement.
# SITE_URL=https://aventurier-blvck.onrender.com

# Notification WhatsApp à chaque nouveau message / avis (voir app/notify.py pour obtenir la clé)
# WHATSAPP_NOTIFY_PHONE=221771034149
# CALLMEBOT_APIKEY=
